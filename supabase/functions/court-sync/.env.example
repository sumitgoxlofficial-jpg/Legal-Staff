# Function secrets for court-sync (Supabase → Edge Functions → Secrets). Never commit real values.
# The API key can instead be stored in Vault from the Court Intelligence admin panel ("Replace API key"): no redeploy needed to rotate it.
COURT_API_PROVIDER=ecourtsindia
COURT_API_URL=https://webapi.ecourtsindia.com
COURT_API_KEY=

ENABLE_OFFICIAL_SOURCES=true
ENABLE_PAID_FALLBACK=true
ENABLE_RESPONSE_CACHE=true
ENABLE_DUPLICATE_REQUEST_BLOCK=true
ENABLE_SMART_REFRESH=true

# Rupees per IST month. When set it overrides the budget saved in the admin panel.
MONTHLY_COURT_API_BUDGET=1000
STOP_API_ON_BUDGET_LIMIT=true

# Optional
COURT_API_TIMEOUT_MS=15000
COURT_SYNC_BATCH=40
