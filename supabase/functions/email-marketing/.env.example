# Function secrets for email-marketing (Supabase → Edge Functions → Secrets). Never commit real values, never put them in config.js or any browser file.
BREVO_API_KEY=                 # Brevo → SMTP & API → API keys (transactional email send). Server-side only.
BREVO_WEBHOOK_SECRET=          # a long random string you choose; Brevo sends it as "Authorization: Bearer <value>" on every webhook call
EMAIL_TOKEN_SECRET=            # random, 32+ characters; signs unsubscribe and attribution links. Changing it invalidates links already emailed: do not rotate casually
GOOGLE_SERVICE_ACCOUNT_JSON=   # the whole service-account key file, as one line of JSON. Share the sheet with its client_email (Viewer)
CRON_SECRET=                   # optional; the Vault secret 'cron_secret' (migration 0003) is also accepted
# Optional tuning
EMAIL_BATCH=25                 # emails sent per scheduler tick (every 5 minutes)
EMAIL_SEND_DELAY_MS=150        # pause between two sends

# listing-razorpay (the Rs 49 directory listing), set as secrets of that function:
# RAZORPAY_KEY_ID=  RAZORPAY_KEY_SECRET=  RAZORPAY_WEBHOOK_SECRET=   (use rzp_test_ keys first)
